datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
  TIMED_OUT
  WAITING
}

enum StepRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
  RETRYING
  TIMED_OUT
}

enum NodeType {
  TRIGGER
  ACTION
  CONDITION
  FILTER
  DELAY
  TRANSFORM
  WEBHOOK
  AI
}

model User {
  id           String               @id @default(uuid())
  email        String               @unique
  passwordHash String?              @map("password_hash")
  firstName    String?              @map("first_name")
  lastName     String?              @map("last_name")
  isActive     Boolean              @default(true) @map("is_active")
  memberships  OrganizationMember[]
  apiKeys      ApiKey[]
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@map("users")
}

model Organization {
  id           String               @id @default(uuid())
  name         String
  slug         String               @unique
  members      OrganizationMember[]
  workspaces   Workspace[]
  subscription Subscription?
  usageRecords UsageRecord[]
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           Role         @default(VIEWER)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Workspace {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  name           String
  slug           String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflows      Workflow[]
  connections    Connection[]
  webhooks       Webhook[]
  apiKeys        ApiKey[]
  scheduledJobs  ScheduledJob[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("workspaces")
}

model Workflow {
  id          String            @id @default(uuid())
  workspaceId String            @map("workspace_id")
  name        String
  description String?
  isActive    Boolean           @default(false) @map("is_active")
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions    WorkflowVersion[]
  runs        WorkflowRun[]
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("workflows")
}

model WorkflowVersion {
  id            String          @id @default(uuid())
  workflowId    String          @map("workflow_id")
  versionNumber Int             @map("version_number")
  status        WorkflowStatus  @default(DRAFT)
  definition    Json            @default("{}")
  checksum      String          @default("")
  publishedAt   DateTime?       @map("published_at")
  workflow      Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodes         WorkflowNode[]
  edges         WorkflowEdge[]
  runs          WorkflowRun[]
  createdAt     DateTime        @default(now()) @map("created_at")

  @@unique([workflowId, versionNumber])
  @@index([workflowId, status])
  @@map("workflow_versions")
}

model WorkflowNode {
  id          String          @id @default(uuid())
  versionId   String          @map("version_id")
  nodeKey     String          @map("node_key")
  type        NodeType
  integration String?
  operation   String?
  config      Json            @default("{}")
  metadata    Json?
  version     WorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, nodeKey])
  @@index([versionId])
  @@map("workflow_nodes")
}

model WorkflowEdge {
  id           String          @id @default(uuid())
  versionId    String          @map("version_id")
  sourceNode   String          @map("source_node")
  targetNode   String          @map("target_node")
  sourceHandle String?         @map("source_handle")
  targetHandle String?         @map("target_handle")
  version      WorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("workflow_edges")
}

model WorkflowRun {
  id             String          @id @default(uuid())
  workflowId     String          @map("workflow_id")
  versionId      String          @map("version_id")
  status         RunStatus       @default(PENDING)
  triggerType    String          @map("trigger_type")
  triggerPayload Json?           @map("trigger_payload")
  contextData    Json?           @map("context_data")
  errorMessage   String?         @map("error_message")
  startedAt      DateTime?       @map("started_at")
  completedAt    DateTime?       @map("completed_at")
  durationMs     Int?            @map("duration_ms")
  workflow       Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version        WorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  stepRuns       StepRun[]
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([workflowId, status])
  @@index([versionId])
  @@map("workflow_runs")
}

model StepRun {
  id            String        @id @default(uuid())
  workflowRunId String        @map("workflow_run_id")
  nodeKey       String        @map("node_key")
  nodeType      NodeType      @map("node_type")
  status        StepRunStatus @default(PENDING)
  inputData     Json?         @map("input_data")
  outputData    Json?         @map("output_data")
  errorMessage  String?       @map("error_message")
  retryCount    Int           @default(0) @map("retry_count")
  startedAt     DateTime?     @map("started_at")
  completedAt   DateTime?     @map("completed_at")
  durationMs    Int?          @map("duration_ms")
  workflowRun   WorkflowRun   @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId, nodeKey])
  @@map("step_runs")
}

model Connection {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  integration String
  name        String
  authType    String    @map("auth_type")
  credentials Bytes
  iv          String
  authTag     String    @map("auth_tag")
  expiresAt   DateTime? @map("expires_at")
  metadata    Json?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, integration])
  @@map("connections")
}

model Webhook {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  publicId    String    @unique @default(uuid()) @map("public_id")
  workflowId  String?   @map("workflow_id")
  secret      String?
  isActive    Boolean   @default(true) @map("is_active")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([publicId])
  @@map("webhooks")
}

model ScheduledJob {
  id             String    @id @default(uuid())
  workspaceId    String    @map("workspace_id")
  workflowId     String    @map("workflow_id")
  cronExpression String?   @map("cron_expression")
  intervalMs     Int?      @map("interval_ms")
  nextRunAt      DateTime  @map("next_run_at")
  lastRunAt      DateTime? @map("last_run_at")
  isActive       Boolean   @default(true) @map("is_active")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([nextRunAt, isActive])
  @@map("scheduled_jobs")
}

model ApiKey {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  name        String
  keyPrefix   String    @map("key_prefix")
  keyHash     String    @map("key_hash")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  isRevoked   Boolean   @default(false) @map("is_revoked")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([keyPrefix])
  @@map("api_keys")
}

model Subscription {
  id                   String       @id @default(uuid())
  organizationId       String       @unique @map("organization_id")
  plan                 String       @default("FREE")
  stripeCustomerId     String?      @map("stripe_customer_id")
  stripeSubscriptionId String?      @map("stripe_subscription_id")
  status               String       @default("active")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model UsageRecord {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  metric         String
  quantity       Int          @default(1)
  periodStart    DateTime     @map("period_start")
  periodEnd      DateTime     @map("period_end")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId, metric, periodStart])
  @@map("usage_records")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
